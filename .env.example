NEXT_PUBLIC_SITE_URL=https://www.howlbysmd.com

# Supabase Auth + database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe commerce
# Keep false until every paid asset, entitlement, webhook, and delivery path
# has been verified in production. Sales are closed unless explicitly true.
COMMERCE_SALES_READY=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PDF_PRICE_ID=
STRIPE_LIFT_GUIDE_PRICE_ID=
STRIPE_MEMBERSHIP_PRICE_ID=

# Private member media
LIFT_PDF_STORAGE_PATH=lift/HWL-LIFT-guide.pdf
MUX_ACCESS_TOKEN=
MUX_SECRET_KEY=
MUX_SIGNING_KEY_ID=
# Base64-encoded PEM private key from Mux Signing Keys, not the API secret.
MUX_PRIVATE_KEY=

# Transactional and contact email
RESEND_API_KEY=
CONTACT_TO_EMAIL=shannonmarydixon@gmail.com
CONTACT_FROM_EMAIL=HWL by SMD <hello@howlbysmd.com>

# Scheduling + relationship engine
# The public booking flow reads published event types without a secret.
CALCOM_PROFILE_URL=https://cal.com/hwlbysmd
# Optional server-only credential for future authenticated Cal.com API work.
# Never expose this value through a NEXT_PUBLIC_ variable.
CALCOM_API_KEY=
# Vercel Cron authorization for relationship-engine jobs
CRON_SECRET=
