{
  "name": "hwl-by-smd",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:local": "next dev --webpack --hostname 127.0.0.1 -p 3001",
    "build": "npm run validate:deploy-env && npm run validate:seo && next build --webpack",
    "build:ci": "npm run validate:seo && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "preflight:preview": "node --env-file-if-exists=.env.preview.local --experimental-strip-types scripts/preflight-preview-release.ts",
    "preflight:preview:post-push": "node --experimental-strip-types scripts/preflight-preview-release.ts --repository-only --require-upstream-sync",
    "preflight:preview:repository": "node --experimental-strip-types scripts/preflight-preview-release.ts --repository-only",
    "test:accessibility": "node --experimental-strip-types --test components/shared/lift-sequence-progress.a11y.test.ts components/layout/navigation.a11y.test.ts",
    "test:auth": "node --experimental-strip-types --experimental-loader ./scripts/test-module-loader.mjs --test scripts/test-auth-boundaries.ts scripts/test-auth-callback.ts scripts/test-admin-api-auth.ts scripts/test-admin-auth.ts scripts/test-admin-logout.ts",
    "test:booking": "node --experimental-strip-types --experimental-loader ./scripts/test-module-loader.mjs --test scripts/test-booking-boundaries.ts scripts/test-calcom-booking-webhook.ts",
    "test:commerce": "node --experimental-strip-types --experimental-loader ./scripts/test-module-loader.mjs --test scripts/test-commerce-reconciliation.ts scripts/test-commerce-runtime-authority.ts scripts/test-scheduled-reconciliation.ts scripts/test-stripe-fulfillment.ts",
    "test:inquiries": "node --experimental-strip-types --experimental-loader ./scripts/test-module-loader.mjs --test scripts/test-admin-inquiry-access.ts scripts/test-inquiry-boundaries.ts scripts/test-inquiry-retention.ts",
    "test:launch-env": "node --experimental-strip-types scripts/test-launch-env.ts",
    "test:preview-release": "node --experimental-strip-types --test scripts/test-preview-release-preflight.ts",
    "typecheck": "tsc --noEmit",
    "validate:deploy-env": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/validate-launch-env.ts --require-explicit-target --allow-local-skip",
    "validate:launch-env": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/validate-launch-env.ts",
    "validate:seo": "node --experimental-strip-types scripts/validate-seo.ts"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@mux/mux-player-react": "^3.13.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.2.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
