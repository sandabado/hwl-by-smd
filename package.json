    "jose": "^6.2.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
