HWL_DEPLOYMENT_TARGET=development
# Required in every environment. Use development locally, preview only in the
# launch Preview scope, and production only in the Production scope. The build
# fails when this explicit boundary is absent or disagrees with VERCEL_ENV.
# Local convenience only. Never install true in CI or Vercel. The committed
# default remains false so every deployed build runs the full provider gate.
HWL_LOCAL_BUILD=false
NEXT_PUBLIC_SITE_URL=https://www.hwlbysmd.com

# Supabase Auth + database
# Modern hosted API keys only. Legacy JWT-based anon/service_role keys are
# intentionally rejected so a compromised or deprecated key cannot satisfy the
# launch gate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe commerce
# Keep false until every paid asset, entitlement, webhook, and delivery path
# has been verified in production. Sales are closed unless explicitly true.
COMMERCE_SALES_READY=false
# Explicitly false in local/Preview test environments and true only in the
# verified Production environment. The server rejects Stripe keys, Prices, and
# webhook events whose mode does not match this value.
STRIPE_LIVEMODE=false
# Exact account that owns the key and Stripe objects in this environment. Use
# the canonical HWL sandbox acct_ ID in local/Preview and the canonical live
# HWLbySMD acct_ ID only in Production.
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Sole launch offer: LIFT video + PDF, $11.11 one time
STRIPE_LIFT_PRODUCT_ID=
STRIPE_LIFT_GUIDE_PRICE_ID=
# Both the Product and Price must carry: hwl_product_id=lift_guide,
# catalog_version=lift-complete-v2, and delivery=video_and_pdf.
# PDF-only checkout and The Den membership are intentionally deferred.

# Private member media
LIFT_PDF_STORAGE_PATH=lift/lift-guide.pdf
LIFT_VIDEO_STORAGE_PATH=lift/complete-lift-v1.mp4
# Optional Phase 2 accessibility enhancement. Checkout does not depend on it.
# Leave empty until the VTT object and signed captions route are verified.
LIFT_VIDEO_CAPTIONS_STORAGE_PATH=
MUX_ACCESS_TOKEN=
MUX_SECRET_KEY=
MUX_SIGNING_KEY_ID=
# Base64-encoded PEM private key from Mux Signing Keys, not the API secret.
MUX_PRIVATE_KEY=

# Transactional and contact email
# Public, non-secret build gate. Only exact lowercase true opens website inquiry
# collection. Keep false until the retention policy and purge procedure are
# owner-approved and published, then rebuild/redeploy after changing it.
NEXT_PUBLIC_INQUIRY_COLLECTION_READY=false
RESEND_API_KEY=
CONTACT_TO_EMAIL=shannon@hwlbysmd.com
CONTACT_FROM_EMAIL=HWL by SMD <hello@hwlbysmd.com>
# Dedicated human destination for commerce recovery alerts. It never falls back
# to the public-inquiry inbox and is required before Production sales can open.
# Approved Production identity: admin@ghosthand.studio (leave examples blank).
COMMERCE_ALERT_TO_EMAIL=
# Required for public inquiry submissions. Use a random value of at least 32
# characters. It keys an HMAC fingerprint; raw client IP addresses are never
# stored. Missing/invalid configuration intentionally closes the form.
INQUIRY_RATE_LIMIT_SECRET=
# Owner-approved launch policy. The preflight requires exactly five submissions
# per address per hour; migration 015 also caps the legacy RPC at five.
INQUIRY_RATE_LIMIT_MAX=5

# Scheduling + relationship engine
# Keep authenticated client-message writes closed until the reply transaction,
# recipient notification, delivery audit, and operator recovery path have all
# passed in Preview. The admin Inbox remains available as a read-only view.
ADMIN_CLIENT_MESSAGING_READY=false
# One-time Shannon administrator handoff. Keep disabled with every pinned value
# empty in normal builds. A fresh owner-approved closed Production candidate may
# set grant or revoke plus the exact human actor UUID, Shannon UUID, non-secret
# approval reference, and exact deployed 40-character Git SHA. Restore disabled
# and clear all four values immediately after profile and audit verification.
ADMIN_SHANNON_HANDOFF_MODE=disabled
ADMIN_SHANNON_HANDOFF_ACTOR_USER_ID=
ADMIN_SHANNON_HANDOFF_TARGET_USER_ID=
ADMIN_SHANNON_HANDOFF_APPROVAL_REFERENCE=
ADMIN_SHANNON_HANDOFF_EXPECTED_GIT_SHA=
# Optional public profile override. /book discovers exact published event types
# and embeds their public calendar/date/time selector without a private API key.
CALCOM_PROFILE_URL=https://cal.com/hwlbysmd
# Optional server-only key for the authenticated HWL admin booking queues.
# Create it under Cal.com Settings > Security. Never use NEXT_PUBLIC_ or commit
# the value. The app verifies /v2/me is exactly hwlbysmd at
# shannon@hwlbysmd.com before requesting attendee data.
CALCOM_API_KEY=
# Signed booking-history ingestion. Keep the ledger flag false until migration
# 016, the private webhook secret, and a signed Preview lifecycle have passed.
# Cal.com is scheduling-only; post-service payment is not configured here.
CALCOM_BOOKING_LEDGER_READY=false
CALCOM_WEBHOOK_SECRET=
# Required server-only authorization for every Vercel Cron route. Use a
# distinct random value of at least 32 characters in each environment. Vercel
# sends it as a Bearer token; never expose it through a NEXT_PUBLIC_ variable.
CRON_SECRET=
